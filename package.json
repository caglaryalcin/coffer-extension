{
  "name": "coffer-extension",
  "version": "1.1.2",
  "description": "Browser extension for securely filling Coffer TOTP codes.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caglaryalcin/coffer-extension.git"
  },
  "bugs": {
    "url": "https://github.com/caglaryalcin/coffer-extension/issues"
  },
  "homepage": "https://github.com/caglaryalcin/coffer-extension#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "verify:sources": "node scripts/verify-sources.mjs",
    "test": "node scripts/test-brand-catalog.mjs",
    "lint:firefox": "web-ext lint --source-dir firefox --self-hosted --warnings-as-errors",
    "lint:chrome": "node --check chrome/background.js && node --check chrome/browser-compat.js && node --check chrome/popup/popup.js",
    "lint": "npm run verify:sources && npm test && npm run lint:firefox && npm run lint:chrome",
    "clean:dist": "node scripts/clean-dist.mjs",
    "package:firefox": "web-ext build --source-dir firefox --artifacts-dir dist --filename coffer-{version}-firefox.zip --overwrite-dest --no-input",
    "package:chrome": "web-ext build --source-dir chrome --artifacts-dir dist --filename coffer-{version}-chrome.zip --overwrite-dest --no-input",
    "package:all": "npm run clean:dist && npm run lint && npm run package:firefox && npm run package:chrome"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  }
}
